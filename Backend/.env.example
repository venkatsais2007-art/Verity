# Copy to .env for local use. Never commit .env.
# Leave blank for local SQLite development; production needs a random value of at least 32 bytes.
SECRET_KEY=

# --- PostgreSQL (option A: one URL) ---
# On Render use the "Internal Database URL" of your PostgreSQL instance.
DATABASE_URL=
# Example: DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- PostgreSQL (option B: separate values, used only if DATABASE_URL is empty) ---
# DB_HOST=
# DB_PORT=5432
# DB_NAME=
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require          # use "require" with Render's EXTERNAL url from your own PC

# Leave DATABASE_URL and DB_* empty to use the local SQLite file (verity.db) for development.

# Optional tuning
# DB_POOL_MAX=10
# AUTO_IMPORT_SQLITE=true     # on first start, import verity.db into an EMPTY PostgreSQL

REVIEW_PROVIDER=gemini
GEMINI_API_KEY=

# Password given to the seeded demo users on a fresh database (defaults to demo123 locally).
# Set a strong value in production.
DEMO_PASSWORD=

# Folder for uploaded files. Leave blank locally; on Render point it at a Disk, e.g. /var/data/uploads
UPLOAD_DIR=
